---
export const prerender = true;
import Layout from '@/layouts/Layout.astro';
import Navbar from '@/components/sections/Navbar.astro';
import Footer from '@/components/sections/Footer.astro';
import BlogIndex from '@/components/sections/BlogIndex.astro';
import { getAlternateUrls } from '@/i18n/routing';
import { buildBreadcrumbSchema, buildBlogSchema } from '@/lib/structuredData';
import { getCollection } from 'astro:content';
import { t } from '@/i18n';

const lang = 'zh';
const pathWithoutLang = 'blog';
const alternates = getAlternateUrls(pathWithoutLang, 'zh', Astro.url.origin).filter(
  (a) => a.hrefLang !== 'x-default'
);

// NOTE: Astro's glob loader lowercases entry ids, so match case-insensitively.
const posts = (
  await getCollection('blog', (entry) => entry.id.toLowerCase().endsWith('-zh'))
).sort((a, b) => b.data.pubDate.localeCompare(a.data.pubDate));

const jsonLd = [
  buildBreadcrumbSchema(lang, [{ name: t(lang, 'blog.title'), path: pathWithoutLang }]),
  buildBlogSchema(
    lang,
    posts.map((post) => ({
      title: post.data.title,
      description: post.data.description,
      path: `blog/${post.id.replace(/-zh$/i, '')}`,
      datePublished: `${post.data.pubDate}T00:00:00+08:00`,
    }))
  ),
];
---

<Layout lang={lang} page="blog" pathWithoutLang={pathWithoutLang} jsonLd={jsonLd}>
  <Navbar
    lang={lang}
    alternateUrls={alternates.map((a) => ({ lang: a.hrefLang, href: a.href }))}
  />

  <main>
    <BlogIndex lang={lang} />
  </main>

  <Footer lang={lang} />
</Layout>
