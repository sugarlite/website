---
export const prerender = true;
import Layout from '@/layouts/Layout.astro';
import Navbar from '@/components/sections/Navbar.astro';
import Footer from '@/components/sections/Footer.astro';
import GuideIndex from '@/components/sections/GuideIndex.astro';
import { getAlternateUrls, getStaticLangPaths } from '@/i18n/routing';
import { t } from '@/i18n';
import { buildBreadcrumbSchema, buildGuideIndexSchema } from '@/lib/structuredData';
import type { Language } from '@/types';

export function getStaticPaths() {
  return getStaticLangPaths();
}

const { lang } = Astro.params;
const locale = lang as Language;
const pathWithoutLang = 'guide';
const alternates = getAlternateUrls(pathWithoutLang, 'zh', Astro.url.origin).filter(
  (a) => a.hrefLang !== 'x-default'
);

const jsonLd = [
  buildBreadcrumbSchema(locale, [{ name: t(locale, 'nav.guides'), path: pathWithoutLang }]),
  buildGuideIndexSchema(locale, [
    {
      title: t(locale, 'guide.bloodSugar.title'),
      description: t(locale, 'guide.bloodSugar.subtitle'),
      path: 'guide/blood-sugar-management',
    },
    {
      title: t(locale, 'guide.diabeticDiet.title'),
      description: t(locale, 'guide.diabeticDiet.subtitle'),
      path: 'guide/diabetic-diet',
    },
  ]),
];
---

<Layout lang={locale} page="guide" pathWithoutLang={pathWithoutLang} jsonLd={jsonLd}>
  <Navbar
    lang={locale}
    alternateUrls={alternates.map((a) => ({ lang: a.hrefLang, href: a.href }))}
  />

  <main>
    <GuideIndex lang={locale} />
  </main>

  <Footer lang={locale} />
</Layout>
