---
export const prerender = true;
import Layout from '@/layouts/Layout.astro';
import Navbar from '@/components/sections/Navbar.astro';
import Footer from '@/components/sections/Footer.astro';
import BlogIndex from '@/components/sections/BlogIndex.astro';
import { getAlternateUrls, getStaticLangPaths } from '@/i18n/routing';
import type { Language } from '@/types';
import { buildBreadcrumbSchema, buildBlogSchema } from '@/lib/structuredData';
import { getCollection } from 'astro:content';
import { t } from '@/i18n';

export function getStaticPaths() {
  return getStaticLangPaths();
}

const { lang } = Astro.params;
const locale = lang as Language;
const pathWithoutLang = 'blog';
const alternates = getAlternateUrls(pathWithoutLang, 'zh', Astro.url.origin).filter(
  (a) => a.hrefLang !== 'x-default'
);

// NOTE: Astro's glob loader lowercases entry ids, so match case-insensitively
// (`-zh-Hant` files have ids ending in `-zh-hant`).
const posts = (
  await getCollection('blog', (entry) =>
    entry.id.toLowerCase().endsWith(`-${locale.toLowerCase()}`)
  )
).sort((a, b) => b.data.pubDate.localeCompare(a.data.pubDate));

const jsonLd = [
  buildBreadcrumbSchema(locale, [{ name: t(locale, 'blog.title'), path: pathWithoutLang }]),
  buildBlogSchema(
    locale,
    posts.map((post) => ({
      title: post.data.title,
      description: post.data.description,
      path: `blog/${post.id.replace(new RegExp(`-${locale}$`, 'i'), '')}`,
      datePublished: `${post.data.pubDate}T00:00:00+08:00`,
    }))
  ),
];
---

<Layout lang={locale} page="blog" pathWithoutLang={pathWithoutLang} jsonLd={jsonLd}>
  <Navbar
    lang={locale}
    alternateUrls={alternates.map((a) => ({ lang: a.hrefLang, href: a.href }))}
  />

  <main>
    <BlogIndex lang={locale} />
  </main>

  <Footer lang={locale} />
</Layout>
