---
export const prerender = true;
import Layout from '@/layouts/Layout.astro';
import Navbar from '@/components/sections/Navbar.astro';
import Footer from '@/components/sections/Footer.astro';
import GuideIndex from '@/components/sections/GuideIndex.astro';
import { getAlternateUrls } from '@/i18n/routing';
import { t } from '@/i18n';
import { buildBreadcrumbSchema, buildGuideIndexSchema } from '@/lib/structuredData';

const lang = 'zh';
const pathWithoutLang = 'guide';
const alternates = getAlternateUrls(pathWithoutLang, 'zh', Astro.url.origin).filter(
  (a) => a.hrefLang !== 'x-default'
);

const jsonLd = [
  buildBreadcrumbSchema(lang, [{ name: t(lang, 'nav.guides'), path: pathWithoutLang }]),
  buildGuideIndexSchema(lang, [
    {
      title: t(lang, 'guide.bloodSugar.title'),
      description: t(lang, 'guide.bloodSugar.subtitle'),
      path: 'guide/blood-sugar-management',
    },
    {
      title: t(lang, 'guide.diabeticDiet.title'),
      description: t(lang, 'guide.diabeticDiet.subtitle'),
      path: 'guide/diabetic-diet',
    },
  ]),
];
---

<Layout lang={lang} page="guide" pathWithoutLang={pathWithoutLang} jsonLd={jsonLd}>
  <Navbar
    lang={lang}
    alternateUrls={alternates.map((a) => ({ lang: a.hrefLang, href: a.href }))}
  />

  <main>
    <GuideIndex lang={lang} />
  </main>

  <Footer lang={lang} />
</Layout>
