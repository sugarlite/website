---
import SEO, { type AlternateUrl } from '@/components/seo/SEO.astro';
import JsonLd from '@/components/seo/JsonLd.astro';
import { getPageMeta, SITE_NAME, DEFAULT_OG_IMAGE } from '@/i18n/meta';
import { getAlternateUrls, getLocalizedPath, LANG_TO_HTML_LANG, SITE } from '@/i18n/routing';
import type { Language } from '@/types';
import type { PageKey } from '@/i18n/meta';
import { SpeedInsights } from '@vercel/speed-insights/react';
import Analytics from '@vercel/analytics/astro';
// Self-hosted fonts (fontsource, unicode-range subsets): no dependency on
// fonts.googleapis.com, which is unreachable in mainland China.
import '@fontsource-variable/outfit';
import '@fontsource-variable/noto-sans-sc';
import '@fontsource-variable/noto-serif-sc';
import '@/styles/global.css';

interface Props {
  lang: Language;
  page: PageKey;
  pathWithoutLang?: string;
  title?: string;
  description?: string;
  keywords?: string;
  ogType?: 'website' | 'article';
  ogImage?: string;
  ogImageType?: string;
  jsonLd?: unknown[];
  noIndex?: boolean;
  preloadHero?: boolean;
  publishedTime?: string;
  modifiedTime?: string;
}

const {
  lang,
  page,
  pathWithoutLang = '',
  title: overrideTitle,
  description: overrideDescription,
  keywords: overrideKeywords,
  ogType: overrideOgType,
  ogImage = DEFAULT_OG_IMAGE,
  ogImageType,
  jsonLd = [],
  noIndex = false,
  preloadHero = false,
  publishedTime,
  modifiedTime,
} = Astro.props;

const pageMeta = getPageMeta(page, lang);
const meta = {
  title: overrideTitle ?? pageMeta.title,
  description: overrideDescription ?? pageMeta.description,
  keywords: overrideKeywords ?? pageMeta.keywords,
  ogType: overrideOgType ?? pageMeta.ogType,
};
const canonical = `${SITE}${getLocalizedPath(lang, pathWithoutLang)}`;
const alternates: AlternateUrl[] = getAlternateUrls(pathWithoutLang);
const htmlLang = LANG_TO_HTML_LANG[lang];
---

<!DOCTYPE html>
<html lang={htmlLang} class="scroll-smooth" data-theme-handler>
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0, viewport-fit=cover"
    />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="baidu-site-verification" content="codeva-pQmYbWdHUF" />

    <!-- Dark mode: apply before any paint to prevent FOUC -->
    <script is:inline>
      (function () {
        try {
          const stored = localStorage.getItem('theme');
          const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
          if (stored === 'dark' || (!stored && prefersDark)) {
            document.documentElement.classList.add('dark');
          }
        } catch (e) {
          // ignore
        }
      })();
    </script>

    <SEO
      lang={lang}
      title={meta.title}
      description={meta.description}
      siteName={SITE_NAME[lang]}
      canonical={canonical}
      ogImage={ogImage}
      ogType={meta.ogType}
      ogImageType={ogImageType}
      keywords={meta.keywords}
      alternateUrls={alternates}
      robots={noIndex ? 'noindex, nofollow' : undefined}
      publishedTime={publishedTime}
      modifiedTime={modifiedTime}
    />

    <JsonLd schema={jsonLd} />

    <!-- RSS feed discovery -->
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`RSS`}
      href={lang === 'zh' ? '/rss.xml' : `/${lang}/rss.xml`}
    />

    {
      preloadHero && (
        <link rel="preload" href="/hero-phone.avif" as="image" type="image/avif" fetchpriority="high" />
      )
    }
    <link
      rel="alternate"
      type="text/plain"
      href={lang === 'zh' ? '/llms.txt' : `/${lang}/llms.txt`}
      title="llms.txt"
    />
    <link
      rel="alternate"
      type="text/html"
      href={lang === 'zh' ? '/llms-full.html' : `/${lang}/llms-full.html`}
      title="LLM-friendly version"
    />

    <!-- Favicon & PWA -->
    <link rel="icon" type="image/png" href="/icon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.json" />

    <!-- Theme -->
    <meta name="theme-color" content="#00C09A" />
    <meta name="msapplication-TileColor" content="#00C09A" />
    <meta name="msapplication-config" content="none" />
    <meta name="color-scheme" content="light dark" />

    <!-- PWA / Mobile -->
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content={SITE_NAME[lang]} />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="application-name" content={SITE_NAME[lang]} />
    <meta name="format-detection" content="telephone=no" />

    <!-- Critical CSS to prevent FOUC -->
    <style is:inline>
      html {
        scroll-behavior: smooth;
      }
      body {
        margin: 0;
        font-family: 'Outfit Variable', 'Noto Sans SC Variable', -apple-system, BlinkMacSystemFont, 'Segoe UI', system-ui, sans-serif;
        background-color: #f8fafc;
        color: #0f172a;
      }
      .dark body {
        background-color: #020617;
        color: #f1f5f9;
      }
      img {
        max-width: 100%;
        height: auto;
      }
    </style>

    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-3X5TG47BLP"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag('js', new Date());
      gtag('config', 'G-3X5TG47BLP');
    </script>

    <!-- Third-party analytics: add real IDs here when needed -->
    <!-- Example: Baidu Analytics
    <script is:inline>
      var _hmt = _hmt || [];
      (function () {
        var hm = document.createElement('script');
        hm.defer = true;
        hm.src = 'https://hm.baidu.com/hm.js?YOUR_BAIDU_ID';
        var s = document.getElementsByTagName('script')[0];
        s.parentNode.insertBefore(hm, s);
      })();
    </script>
    -->
    <!-- Example: Microsoft Clarity
    <script is:inline>
      (function (c, l, a, r, i, t, y) {
        c[a] = c[a] || function () { (c[a].q = c[a].q || []).push(arguments); };
        t = l.createElement(r); t.defer = true; t.src = 'https://www.clarity.ms/tag/' + i;
        y = l.getElementsByTagName(r)[0]; y.parentNode.insertBefore(t, y);
      })(window, document, 'clarity', 'script', 'YOUR_CLARITY_ID');
    </script>
    -->
  </head>

  <body
    class="bg-slate-50 text-slate-900 dark:bg-slate-950 dark:text-slate-100 transition-colors duration-300 min-h-screen"
  >
    <slot />

    <SpeedInsights client:only="react" />
    <Analytics />
  </body>

  <script is:inline>
    (function () {
      if (typeof window.IntersectionObserver === 'undefined') return;

      var els = document.querySelectorAll('.reveal, .reveal-scale');
      if (!els.length) return;

      var observer = new IntersectionObserver(
        function (entries) {
          entries.forEach(function (entry) {
            if (entry.isIntersecting) {
              entry.target.classList.remove('reveal-hidden');
              entry.target.classList.add('visible');
              observer.unobserve(entry.target);
            }
          });
        },
        { threshold: 0, rootMargin: '50px 0px' }
      );

      function revealInView() {
        els.forEach(function (el) {
          var rect = el.getBoundingClientRect();
          var inView = rect.top < window.innerHeight && rect.bottom > 0;
          if (inView) {
            el.classList.remove('reveal-hidden');
            el.classList.add('visible');
          } else {
            el.classList.add('reveal-hidden');
            observer.observe(el);
          }
        });
      }

      // Initial pass
      revealInView();

      // Safety net: reveal all after load + short delay
      window.addEventListener('load', function () {
        setTimeout(function () {
          els.forEach(function (el) {
            el.classList.remove('reveal-hidden');
            el.classList.add('visible');
          });
          observer.disconnect();
        }, 300);
      });
    })();
  </script>
</html>
